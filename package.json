{
  "name": "halo-technologies-site",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test scripts/site.test.mjs",
    "check": "node --check js/script.js && node --check blog/blog.js && node --check blog/data/articles.js",
    "indexnow": "node scripts/indexnow.mjs",
    "validate:html": "html-validate --config scripts/htmlvalidate.json \"dist/**/*.html\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "html-validate": "11.16.0",
    "linkedom": "0.18.13"
  }
}
